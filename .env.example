SEED_KEY_1=
SEED_KEY_2=
SEED_KEY_3=
FLOOD_KEY=
# Funds throwaway browser identities. Falls back to SEED_KEY_1 in `npm run dev`. Server side only.
DRIP_KEY=
# The location checker wallet. Its address must be listed in data/attesters.json. Server side only.
ATTEST_KEY=
# The press curator wallet. Its address must be listed in data/curators.json. Used only by npm run seed:press.
PRESS_KEY=
# An Arkiv Hub access key (hub.arkiv.network/access-keys). Server side only, sent as X-API-KEY. Never a VITE_ variable. See docs/deploy.md.
ARKIV_ACCESS_KEY=
# Public RPC by default. Put an access key URL from hub.arkiv.network here to give the server relay a bigger budget.
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# Set to 1 at build time to read through /api/rpc instead of the public RPC.
VITE_RPC_RELAY=
# The human check before the faucet funds a new browser key. Leave all of these empty to use the built-in proof of work.
# Cloudflare Turnstile (dash.cloudflare.com > Turnstile, free). The site key is public and is returned by /api/human; the secret stays on the server.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# Signs the proof-of-work challenges. Any long random string. Falls back to DRIP_KEY, which is not ideal to reuse.
HUMAN_SECRET=
# Optional sentence assistant. The slip fills on the device without it.
IFM_API_KEY=
IFM_BASE_URL=https://api.ifm.ai/v1
IFM_MODEL=IFM/K2-Horizon-375B-A23B
